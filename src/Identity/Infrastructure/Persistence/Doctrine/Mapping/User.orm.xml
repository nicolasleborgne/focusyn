<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <!--
        L'agrégat User ne porte aucun attribut Doctrine : toute la
        correspondance objet/table tient dans ce fichier, côté infrastructure.

        La stratégie de génération est NONE : l'identifiant est un UUID v7
        produit par le domaine, ce qui permet à l'agrégat d'être complet avant
        tout aller-retour avec la base.
    -->
    <entity name="App\Identity\Domain\Model\User" table="users">
        <id name="id" type="user_id" column="id">
            <generator strategy="NONE"/>
        </id>

        <field name="email" type="email_address" column="email" unique="true"/>
        <field name="password" type="hashed_password" column="password_hash"/>
        <field name="registeredAt" type="datetime_immutable" column="registered_at"/>

        <unique-constraints>
            <unique-constraint name="uniq_users_email" columns="email"/>
        </unique-constraints>
    </entity>
</doctrine-mapping>
