<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <!--
        L'agrégat User ne porte aucun attribut Doctrine : toute la
        correspondance objet/table tient dans ce fichier, côté infrastructure.

        La stratégie de génération est NONE : l'identifiant est un UUID v7
        produit par le domaine, ce qui permet à l'agrégat d'être complet avant
        tout aller-retour avec la base.
    -->
    <entity name="App\Identity\Domain\Model\User" table="users">
        <id name="id" type="user_id" column="id">
            <generator strategy="NONE"/>
        </id>

        <field name="email" type="email_address" column="email" unique="true"/>
        <!-- L'adresse demandée, tant qu'elle n'est pas confirmée. Pas d'unicité :
             deux personnes peuvent demander la même, une seule la confirmera. -->
        <field name="pendingEmail" type="email_address" column="pending_email" nullable="true"/>
        <field name="password" type="hashed_password" column="password_hash"/>
        <field name="registeredAt" type="datetime_immutable" column="registered_at"/>

        <!--
            Le secret TOTP est stocké en clair : l'algorithme exige que le
            serveur puisse recalculer le code. Les codes de secours, eux, sont
            des empreintes — ils sont montrés une fois puis oubliés.
        -->
        <field name="totpSecret" type="totp_secret" column="totp_secret" nullable="true"/>
        <field name="backupCodes" type="json" column="backup_codes"/>

        <field name="display" type="display_preferences" column="display_preferences"/>

        <one-to-many field="oauthIdentities"
                     target-entity="App\Identity\Domain\Model\OAuthIdentity"
                     mapped-by="user"
                     orphan-removal="true"
                     fetch="EAGER">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-many>

        <unique-constraints>
            <unique-constraint name="uniq_users_email" columns="email"/>
        </unique-constraints>
    </entity>
</doctrine-mapping>
