<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Routine\Domain\Model\Routine" table="routines">
        <id name="id" type="routine_id" column="id">
            <generator strategy="NONE"/>
        </id>

        <field name="tenantId" type="tenant_id" column="organization_id"/>
        <field name="name" type="routine_name" column="name"/>
        <field name="cadence" type="string" column="cadence" length="10"
               enum-type="App\Routine\Domain\Model\Cadence"/>
        <!-- Le nom de l'obsession servie, pas son identifiant : une routine ne
             connaît pas Notebook, et une obsession effacée ne doit rien casser. -->
        <field name="obsession" type="string" column="obsession" length="60" nullable="true"/>
        <field name="openedAt" type="datetime_immutable" column="opened_at"/>
        <field name="updatedAt" type="datetime_immutable" column="updated_at"/>

        <one-to-many field="items"
                     target-entity="App\Routine\Domain\Model\RoutineItem"
                     mapped-by="routine"
                     orphan-removal="true"
                     fetch="EAGER">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-many>

        <!-- Les cochages sont chargés avec la routine : la série les parcourt
             tous, et une requête par routine à l'affichage de la barre
             latérale coûterait plus que de les lire d'un coup. -->
        <one-to-many field="ticks"
                     target-entity="App\Routine\Domain\Model\RoutineTick"
                     mapped-by="routine"
                     orphan-removal="true"
                     fetch="EAGER">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-many>

        <indexes>
            <index name="idx_routines_org_opened" columns="organization_id,opened_at"/>
        </indexes>
    </entity>
</doctrine-mapping>
