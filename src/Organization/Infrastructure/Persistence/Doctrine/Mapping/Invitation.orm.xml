<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <!--
        Pas de cloisonnement Doctrine : celui qui accepte n'est pas encore
        membre, et le filtre — armé sur *son* organisation courante — masquerait
        l'invitation qu'il vient de recevoir. La colonne organization_id est
        donc une donnée, pas un discriminant de filtre.
    -->
    <entity name="App\Organization\Domain\Model\Invitation" table="organization_invitations">
        <id name="id" type="invitation_id" column="id">
            <generator strategy="NONE"/>
        </id>

        <field name="organizationId" type="organization_id" column="organization_id"/>
        <field name="email" type="invited_email" column="email"/>
        <field name="role" type="string" column="role" length="20"
               enum-type="App\Organization\Domain\Model\OrganizationRole"/>
        <field name="token" type="invitation_token" column="token" unique="true"/>
        <field name="invitedBy" type="member_id" column="invited_by"/>
        <field name="createdAt" type="datetime_immutable" column="created_at"/>
        <field name="expiresAt" type="datetime_immutable" column="expires_at"/>
        <field name="acceptedAt" type="datetime_immutable" column="accepted_at" nullable="true"/>

        <unique-constraints>
            <!-- Une seule invitation en cours par adresse et par organisation :
                 inviter deux fois doit remplacer, pas empiler. -->
            <unique-constraint name="uniq_invitation_org_email" columns="organization_id,email"/>
        </unique-constraints>
    </entity>
</doctrine-mapping>
