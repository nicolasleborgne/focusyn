# Valeurs par défaut du développement local (services fournis par devenv).
MAILER_DSN=smtp://127.0.0.1:1025

# Le développement a besoin d'un secret non vide : la protection CSRF le dérive
# pour signer les jetons. Sans lui, tout écran portant un formulaire tombe en
# 500. Cette valeur ne vaut que pour cette machine ; la production passe par le
# coffre à secrets.
APP_SECRET=focusyn-dev-secret-sans-valeur-en-production

# Paire VAPID de développement, sans valeur ailleurs : sans elle, la ligne
# « notifications système » ne se rend pas et personne ne peut la regarder.
# La production a la sienne, tirée par `console app:vapid`.
VAPID_PUBLIC_KEY=BN_C3VNffjf2JEhmHUeUjO1EO-jIX-TxCfU7SC5ep7mYb2a1_JnukkcCKY3f5H7NMKKUavpFjUl10RoQNBH6QmY
VAPID_PRIVATE_KEY=h1txCYwKPw01IG-2p7zQbkFVq5mIu-nQgslZ9U3RZcs

# Secret de scellement de développement : sans lui, l'écran des réglages tombe
# dès qu'on veut enregistrer une clé.
ASSISTANT_SECRET=iGUbUvRqfef74CqQj23qqXgCdTPtrdXED/IEtT077DA=
