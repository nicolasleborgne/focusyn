{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          { "breaking": true, "release": "minor" }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      { "preset": "conventionalcommits" }
    ],
    [
      "@semantic-release/exec",
      {
        "verifyReleaseCmd": "echo 'publier=oui' >> \"$GITHUB_OUTPUT\"; echo 'version=${nextRelease.version}' >> \"$GITHUB_OUTPUT\""
      }
    ],
    [
      "@semantic-release/github",
      { "successComment": false, "failComment": false, "addReleases": false }
    ]
  ]
}
