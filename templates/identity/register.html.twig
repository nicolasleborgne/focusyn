{% extends 'base.html.twig' %}

{% block title %}{{ 'auth.sign_up'|trans }} — Focusyn{% endblock %}

{% block body %}
    {% embed 'identity/_auth_frame.html.twig' %}
        {% block auth %}
            <h1 class="fx-heading fx-heading--dialog">{{ 'auth.sign_up_title'|trans }}</h1>
            <p class="fx-auth__lead">{{ 'auth.sign_up_lead'|trans }}</p>

            {{ form_start(form) }}
                <div class="fx-auth__fields">
                    {{ form_widget(form.email, { attr: {
                        class: 'fx-auth__input',
                        placeholder: 'auth.email'|trans,
                        'aria-label': 'auth.email'|trans,
                    } }) }}
                    {{ form_widget(form.plainPassword, { attr: {
                        class: 'fx-auth__input',
                        placeholder: 'auth.password'|trans,
                        'aria-label': 'auth.password'|trans,
                    } }) }}
                </div>

                <button type="submit" class="fx-button fx-button--primary fx-button--block">
                    {{ 'auth.create_account'|trans }}
                </button>
            {{ form_end(form) }}

            <p class="fx-auth__recourse">
                <a href="{{ path('login') }}">{{ 'auth.have_account'|trans }}</a>
            </p>

            <div class="fx-auth__message {{ not form.vars.valid ? 'fx-auth__message--error' }}" role="status">
                {%- for error in form.email.vars.errors %}{{ error.message }} {% endfor -%}
                {%- for error in form.plainPassword.vars.errors %}{{ error.message }} {% endfor -%}
                {%- if form.vars.valid %}{{ 'registration.password.help'|trans }}{% endif -%}
            </div>
        {% endblock %}
    {% endembed %}
{% endblock %}
