{% extends 'base.html.twig' %}

{% block title %}{{ 'auth.sign_in'|trans }} — Focusyn{% endblock %}

{% block body %}
    {% embed 'identity/_auth_frame.html.twig' %}
        {% block auth %}
            <h1 class="fx-heading fx-heading--dialog">{{ 'auth.sign_in_title'|trans }}</h1>

            <form method="post" action="{{ path('login') }}">
                <div class="fx-auth__fields">
                    <input class="fx-auth__input" type="email" name="login[email]"
                           value="{{ lastEmail }}" placeholder="{{ 'auth.email'|trans }}"
                           aria-label="{{ 'auth.email'|trans }}" autocomplete="email" required autofocus>

                    <input class="fx-auth__input" type="password" name="login[password]"
                           placeholder="{{ 'auth.password'|trans }}"
                           aria-label="{{ 'auth.password'|trans }}" autocomplete="current-password" required>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="fx-button fx-button--primary fx-button--block">
                    {{ 'auth.sign_in'|trans }}
                </button>
            </form>

            <p class="fx-auth__recourse">
                <a href="{{ path('password_request') }}">{{ 'auth.forgotten'|trans }}</a>
                <a href="{{ path('register') }}">{{ 'auth.sign_up'|trans }}</a>
            </p>

            {% if providers is not empty %}
                <p class="fx-auth__separator">{{ 'auth.or'|trans }}</p>
                <div class="fx-auth__providers">
                    {% for provider in providers %}
                        <a class="fx-button fx-button--block" href="{{ path('oauth_start', { provider: provider.value }) }}">
                            {{ 'settings.providers.sign_in_with'|trans({ provider: provider.label }) }}
                        </a>
                    {% endfor %}
                </div>
            {% endif %}

            {# Hauteur réservée en permanence : l'apparition d'un message ne doit
               pas faire sauter le formulaire au moment où on clique. #}
            <p class="fx-auth__message {{ (error or app.flashes('oauth_error')) ? 'fx-auth__message--error' }}" role="status">
                {%- if error -%}
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                {%- else -%}
                    {%- for message in app.flashes('oauth_error') %}{{ message }}{% endfor -%}
                    {%- for message in app.flashes('success') %}{{ message|trans }}{% endfor -%}
                {%- endif -%}
            </p>
        {% endblock %}
    {% endembed %}
{% endblock %}
