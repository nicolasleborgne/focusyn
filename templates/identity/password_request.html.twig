{% extends 'base.html.twig' %}

{% block title %}{{ 'password_reset.request_title'|trans }} — Focusyn{% endblock %}

{% block body %}
    {% embed 'identity/_auth_frame.html.twig' %}
        {% block auth %}
            <h1 class="fx-heading fx-heading--dialog">{{ 'password_reset.request_title'|trans }}</h1>
            <p class="fx-auth__lead">{{ 'password_reset.request_lead'|trans }}</p>

            {% if sent %}
                {# Le même message que l'adresse existe ou non — et le même
                   encore lorsque la boîte visée a atteint sa limite. #}
                <p class="fx-auth__message" role="status">{{ 'password_reset.sent'|trans }}</p>
            {% else %}
                {# La ligne de message garde sa place : sinon l'apparition du
                   refus fait sauter le formulaire au moment du clic. #}
                <p class="fx-auth__message {{ throttled ? 'fx-auth__message--error' }}" role="alert">
                    {%- if throttled %}{{ 'password_reset.throttled'|trans }}{% endif -%}
                </p>

                <form method="post" action="{{ path('password_request') }}">
                    {# Jeton sans session, comme la connexion et l'inscription :
                       la valeur rendue est le *nom* du jeton, que le contrôleur
                       `csrf-protection` remplace par un aléa qu'il pose aussi
                       en cookie. Sans `data-controller` sur ce champ, rien ne
                       fait la substitution et chaque envoi est refusé. #}
                    <input type="hidden" name="_token" data-controller="csrf-protection"
                           value="{{ csrf_token('password-request') }}">
                    <div class="fx-auth__fields">
                        <input class="fx-auth__input" type="email" name="email" value="{{ email }}"
                               placeholder="{{ 'auth.email'|trans }}" aria-label="{{ 'auth.email'|trans }}"
                               autocomplete="email" required autofocus>
                    </div>

                    <button type="submit" class="fx-button fx-button--primary fx-button--block">
                        {{ 'password_reset.send_link'|trans }}
                    </button>
                </form>
            {% endif %}

            <a class="fx-auth__back" href="{{ path('login') }}">← {{ 'auth.back_to_sign_in'|trans }}</a>
        {% endblock %}
    {% endembed %}
{% endblock %}
