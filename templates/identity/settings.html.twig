{% extends 'shell.html.twig' %}

{% block title %}{{ 'shell.nav.settings'|trans }} — Focusyn{% endblock %}
{% set crumb = 'shell.nav.settings'|trans %}

{% block page %}
    <div class="fx-app__content fx-app__content--settings">
        <h1 class="fx-heading">{{ 'settings.title'|trans }}</h1>

        {% for message in app.flashes('success') %}
            <p class="fx-settings__notice" role="status">{{ message|trans }}</p>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <p class="fx-auth__error" role="alert">{{ message|trans }}</p>
        {% endfor %}

        {# ---------------------------------------------------------------- #}
        {# Compte : identité, mot de passe, second facteur. La maquette range
           les trois sous un seul intitulé — ce sont les clés de la porte. #}
        <section class="fx-settings__section">
            <p class="fx-eyebrow">{{ 'settings.account'|trans }}</p>

            <div class="fx-settings__row fx-settings__row--identity">
                <span class="fx-avatar fx-avatar--large" aria-hidden="true">{{ account.email|first|upper }}</span>
                <div class="fx-settings__label">
                    {# Rien ne change à l'envoi : la nouvelle adresse attend
                       d'être confirmée depuis sa propre boîte aux lettres. #}
                    <form method="post" action="{{ path('email_change_request') }}" class="fx-field__row">
                        <input type="hidden" name="_token" value="{{ csrf_token('email-change') }}">
                        <input class="fx-settings__mail" type="email" name="email" required
                               value="{{ account.pendingEmail ?? account.email }}"
                               aria-label="{{ 'auth.email'|trans }}">
                        <button type="submit" class="fx-button fx-button--small">{{ 'email_change.submit'|trans }}</button>
                    </form>

                    {% if account.pendingEmail %}
                        <span class="fx-card__help fx-settings__pending">
                            {{ 'email_change.pending'|trans({ email: account.pendingEmail }) }}
                        </span>
                        <form method="post" action="{{ path('email_change_request') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('email-change') }}">
                            <button type="submit" name="cancel" value="1" class="fx-settings__cancel">
                                {{ 'email_change.cancel'|trans }}
                            </button>
                        </form>
                    {% else %}
                        <span class="fx-card__help">{{ 'settings.account_help'|trans }}</span>
                    {% endif %}
                </div>
            </div>

            <div class="fx-settings__row">
                <div class="fx-settings__label">
                    <span class="fx-card__title">{{ 'auth.password'|trans }}</span>
                    <span class="fx-card__help">{{ 'settings.password_help'|trans }}</span>
                </div>

                <a class="fx-button fx-button--small" href="{{ path('password_request') }}">
                    {{ 'settings.password_reset'|trans }}
                </a>
            </div>

            <div class="fx-settings__row">
                <div class="fx-settings__label">
                    <span class="fx-card__title">{{ 'settings.two_factor.totp'|trans }}</span>
                    <span class="fx-card__help">{{ 'settings.two_factor.help'|trans }}</span>
                </div>

                {% if account.twoFactorEnabled %}
                    <form method="post" action="{{ path('two_factor_disable') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('two-factor-disable') }}">
                        <button type="submit" class="fx-button fx-button--small">{{ 'settings.two_factor.disable'|trans }}</button>
                    </form>
                {% else %}
                    <a class="fx-button fx-button--primary fx-button--small" href="{{ path('two_factor_enrolment') }}">
                        {{ 'settings.two_factor.enable'|trans }}
                    </a>
                {% endif %}
            </div>

            {% if account.twoFactorEnabled %}
                <div class="fx-settings__row">
                    <div class="fx-settings__label">
                        <span class="fx-card__title">{{ 'settings.backup_codes.heading'|trans }}</span>
                        <span class="fx-card__help {{ account.backupCodesRunningLow ? 'fx-settings__warning' }}">
                            {{ 'settings.backup_codes.remaining'|trans({ count: account.remainingBackupCodes }) }}
                        </span>
                    </div>

                    <form method="post" action="{{ path('backup_codes_regenerate') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('backup-codes-regenerate') }}">
                        <button type="submit" class="fx-button fx-button--small">{{ 'settings.backup_codes.regenerate'|trans }}</button>
                    </form>
                </div>
            {% endif %}

            {# Les sessions ouvertes. Fermer la sienne, c'est se déconnecter :
               le bouton le dit, il ne fait pas semblant. #}
            {% for session in account.sessions %}
                <div class="fx-settings__row">
                    <div class="fx-settings__label">
                        <span class="fx-card__title">{{ session.device }}</span>
                        <span class="fx-card__help">
                            {%- if session.current -%}
                                {{ 'settings.sessions.current'|trans }}
                            {%- else -%}
                                {{ 'settings.sessions.last_seen'|trans({ when: session.lastSeenAt|fx_ago }) }}
                            {%- endif -%}
                        </span>
                    </div>

                    <form method="post" action="{{ path('session_revoke') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('session-revoke') }}">
                        <input type="hidden" name="sessionId" value="{{ session.id }}">
                        <button type="submit" class="fx-button fx-button--small">
                            {{ (session.current ? 'shell.action.logout' : 'settings.sessions.revoke')|trans }}
                        </button>
                    </form>
                </div>
            {% endfor %}

            {% if freshBackupCodes is not empty %}
                <div class="fx-card fx-settings__codes">
                    <p class="fx-card__title">{{ 'settings.backup_codes.fresh'|trans }}</p>
                    <p class="fx-card__help">{{ 'settings.backup_codes.fresh_help'|trans }}</p>
                    <ul class="fx-settings__code-list">
                        {% for code in freshBackupCodes %}
                            <li class="fx-settings__code">{{ code }}</li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        </section>

        {# ---------------------------------------------------------------- #}
        <section class="fx-settings__section">
            <p class="fx-eyebrow">{{ 'team.heading'|trans }}</p>

            <div class="fx-settings__row">
                <div class="fx-settings__label">
                    <span class="fx-card__title">{{ 'settings.team.label'|trans }}</span>
                    <span class="fx-card__help">{{ 'settings.team.help'|trans }}</span>
                </div>

                <a class="fx-button fx-button--small" href="{{ path('team') }}">{{ 'settings.team.open'|trans }}</a>
            </div>
        </section>

        {# ---------------------------------------------------------------- #}
        <section class="fx-settings__section">
            <p class="fx-eyebrow">{{ 'settings.accent.heading'|trans }}</p>

            <div class="fx-settings__row">
                <div class="fx-settings__label">
                    <span class="fx-card__title">{{ 'settings.accent.label'|trans }}</span>
                    <span class="fx-card__help">{{ 'settings.accent.help'|trans }}</span>
                </div>

                <form method="post" action="{{ path('display_adjust') }}" class="fx-accents">
                    <input type="hidden" name="_token" value="{{ csrf_token('display-adjust') }}">
                    {% for accent in accents %}
                        <button type="submit" name="accent" value="{{ accent.value }}"
                                class="fx-accents__dot {{ display().accent == accent.value ? 'fx-accents__dot--current' }}"
                                style="background: {{ accent.hex }}"
                                aria-label="{{ ('settings.accent.' ~ accent.value)|trans }}"
                                {{ display().accent == accent.value ? 'aria-current="true"' : '' }}></button>
                    {% endfor %}
                </form>
            </div>
        </section>

        {# ---------------------------------------------------------------- #}
        <section class="fx-settings__section">
            <p class="fx-eyebrow">{{ 'settings.editor.heading'|trans }}</p>

            <div class="fx-settings__row">
                <div class="fx-settings__label">
                    <span class="fx-card__title">{{ 'settings.editor.serif'|trans }}</span>
                    <span class="fx-card__help">{{ 'settings.editor.serif_help'|trans }}</span>
                </div>

                <form method="post" action="{{ path('display_adjust') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('display-adjust') }}">
                    <input type="hidden" name="proseFont" value="{{ display().proseFont == 'serif' ? 'sans' : 'serif' }}">
                    <button type="submit" class="fx-switch {{ display().proseFont == 'serif' ? 'fx-switch--on' }}"
                            aria-pressed="{{ display().proseFont == 'serif' ? 'true' : 'false' }}">
                        <span class="fx-switch__track"><span class="fx-switch__knob"></span></span>
                    </button>
                </form>
            </div>

            <div class="fx-settings__row">
                <div class="fx-settings__label">
                    <span class="fx-card__title">{{ 'settings.editor.preview'|trans }}</span>
                    <span class="fx-card__help">{{ 'settings.editor.preview_help'|trans }}</span>
                </div>

                <form method="post" action="{{ path('display_adjust') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('display-adjust') }}">
                    <input type="hidden" name="previewPane" value="{{ display().previewPane ? '0' : '1' }}">
                    <button type="submit" class="fx-switch {{ display().previewPane ? 'fx-switch--on' }}"
                            aria-pressed="{{ display().previewPane ? 'true' : 'false' }}">
                        <span class="fx-switch__track"><span class="fx-switch__knob"></span></span>
                    </button>
                </form>
            </div>

            <div class="fx-settings__row">
                <div class="fx-settings__label">
                    <span class="fx-card__title">{{ 'settings.editor.marks'|trans }}</span>
                    <span class="fx-card__help">{{ 'settings.editor.marks_help'|trans }}</span>
                </div>

                <form method="post" action="{{ path('display_adjust') }}" class="fx-field__row">
                    <input type="hidden" name="_token" value="{{ csrf_token('display-adjust') }}">
                    {% for opacity in opacities %}
                        <button type="submit" name="markOpacity" value="{{ opacity }}"
                                class="fx-pill {{ display().markOpacity == opacity ? 'fx-pill--selected' }}">
                            {{ (opacity * 100)|round }} %
                        </button>
                    {% endfor %}
                </form>
            </div>
        </section>

        {# ---------------------------------------------------------------- #}
        <section class="fx-settings__section">
            <p class="fx-eyebrow">{{ 'settings.library.heading'|trans }}</p>

            <div class="fx-settings__row">
                <div class="fx-settings__label">
                    <span class="fx-card__title">{{ 'settings.library.density'|trans }}</span>
                    <span class="fx-card__help">{{ 'settings.library.density_help'|trans }}</span>
                </div>

                <form method="post" action="{{ path('display_adjust') }}" class="fx-field__row">
                    <input type="hidden" name="_token" value="{{ csrf_token('display-adjust') }}">
                    {% for density in densities %}
                        <button type="submit" name="density" value="{{ density.value }}"
                                class="fx-pill {{ display().density == density.value ? 'fx-pill--selected' }}">
                            {{ ('settings.library.' ~ density.value)|trans }}
                        </button>
                    {% endfor %}
                </form>
            </div>
        </section>

        {# Sections portées par leurs contextes : les réglages ne les
           connaissent pas, ils les appellent. #}
        <twig:AssistantSection />

        <twig:ReminderSection />

        <twig:PrivacySection />

        {# ---------------------------------------------------------------- #}
        <section class="fx-settings__section">
            <p class="fx-eyebrow">{{ 'settings.providers.heading'|trans }}</p>

            {% for provider in providers %}
                <div class="fx-settings__row">
                    <div class="fx-settings__label">
                        <span class="fx-card__title">{{ provider.label }}</span>
                        <span class="fx-card__help">
                            {{ (account.hasLinked(provider.value) ? 'settings.providers.linked' : 'settings.providers.not_linked')|trans }}
                        </span>
                    </div>

                    {% if account.hasLinked(provider.value) %}
                        <form method="post" action="{{ path('oauth_unlink', { provider: provider.value }) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('oauth-unlink') }}">
                            <button type="submit" class="fx-button fx-button--small">{{ 'settings.providers.unlink'|trans }}</button>
                        </form>
                    {% else %}
                        <a class="fx-button fx-button--small" href="{{ path('oauth_start', { provider: provider.value }) }}">
                            {{ 'settings.providers.link'|trans }}
                        </a>
                    {% endif %}
                </div>
            {% endfor %}
        </section>
    </div>
{% endblock %}
