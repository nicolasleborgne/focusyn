{% extends 'base.html.twig' %}

{% block title %}{{ 'two_factor.title'|trans }} — Focusyn{% endblock %}

{% block body %}
    {% embed 'identity/_auth_frame.html.twig' %}
        {% block auth %}
            <h1 class="fx-heading fx-heading--dialog">{{ 'two_factor.title'|trans }}</h1>
            <p class="fx-auth__lead">{{ 'two_factor.lead'|trans }}</p>

            <form action="{{ checkPathUrl|default(path(checkPathRoute)) }}" method="post">
                <div class="fx-auth__fields">
                    <input class="fx-auth__input fx-auth__input--code" type="text"
                           name="{{ authCodeParameterName }}" placeholder="000000"
                           aria-label="{{ 'two_factor.code'|trans }}"
                           inputmode="numeric" autocomplete="one-time-code"
                           pattern="[0-9A-Za-z\-]*" autofocus required>
                </div>

                {% if isCsrfProtectionEnabled %}
                    <input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">
                {% endif %}

                <button type="submit" class="fx-button fx-button--primary fx-button--block">
                    {{ 'two_factor.verify'|trans }}
                </button>
            </form>

            <form action="{{ logoutPath }}" method="post">
                <button type="submit" class="fx-auth__back">← {{ 'two_factor.cancel'|trans }}</button>
            </form>

            <p class="fx-auth__message {{ authenticationError ? 'fx-auth__message--error' }}" role="status">
                {{- authenticationError ? authenticationError|trans(authenticationErrorData, 'SchebTwoFactorBundle') : 'two_factor.help'|trans -}}
            </p>
        {% endblock %}
    {% endembed %}
{% endblock %}
