{% extends 'base.html.twig' %}

{% block title %}{{ 'password_reset.title'|trans }} — Focusyn{% endblock %}

{% block body %}
    {% embed 'identity/_auth_frame.html.twig' %}
        {% block auth %}
            {% if expired %}
                <h1 class="fx-heading fx-heading--dialog">{{ 'password_reset.expired_title'|trans }}</h1>
                <p class="fx-auth__lead">{{ 'password_reset.expired_lead'|trans }}</p>
                <a class="fx-button fx-button--primary fx-button--block" href="{{ path('password_request') }}">
                    {{ 'password_reset.request_again'|trans }}
                </a>
            {% else %}
                <h1 class="fx-heading fx-heading--dialog">{{ 'password_reset.title'|trans }}</h1>
                <p class="fx-auth__lead">{{ 'registration.password.help'|trans }}</p>

                <form method="post">
                    <div class="fx-auth__fields">
                        <input class="fx-auth__input" type="password" name="password"
                               placeholder="{{ 'password_reset.new_password'|trans }}"
                               aria-label="{{ 'password_reset.new_password'|trans }}"
                               autocomplete="new-password" required autofocus>
                    </div>

                    <button type="submit" class="fx-button fx-button--primary fx-button--block">
                        {{ 'password_reset.save'|trans }}
                    </button>
                </form>

                <p class="fx-auth__message {{ error ? 'fx-auth__message--error' }}" role="status">
                    {{- error ? error|trans([], 'validators') -}}
                </p>
            {% endif %}

            <a class="fx-auth__back" href="{{ path('login') }}">← {{ 'auth.back_to_sign_in'|trans }}</a>
        {% endblock %}
    {% endembed %}
{% endblock %}
