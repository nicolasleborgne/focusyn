{% extends 'shell.html.twig' %}

{% block title %}{{ 'billing.heading'|trans }} — Focusyn{% endblock %}
{% set crumb = 'billing.heading'|trans %}

{% block page %}
    <div class="fx-app__content fx-app__content--settings">
        <h1 class="fx-heading">{{ 'billing.heading'|trans }}</h1>

        {% for message in app.flashes('success') %}
            <p class="fx-settings__notice" role="status">{{ message|trans }}</p>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <p class="fx-auth__error" role="alert">{{ message|trans }}</p>
        {% endfor %}

        {# Le paiement vient d'être fait, mais c'est le webhook qui ouvre le
           palier : le dire évite de croire que rien ne s'est passé. #}
        {% if justPaid %}
            <p class="fx-settings__notice" role="status">{{ 'billing.just_paid'|trans }}</p>
        {% endif %}

        {% if billing.needsAttention %}
            <p class="fx-auth__error" role="alert">{{ 'billing.past_due'|trans }}</p>
        {% endif %}

        {# ---------------------------------------------------------------- #}
        <section class="fx-settings__section">
            <p class="fx-eyebrow">{{ 'billing.current'|trans }}</p>

            <div class="fx-settings__row">
                <div class="fx-settings__label">
                    <span class="fx-card__title">{{ ('billing.plan.' ~ billing.entitled.value)|trans }}</span>
                    <span class="fx-card__help">
                        {%- if billing.trialing -%}
                            {{ 'billing.trial_until'|trans({ when: billing.trialEndsAt|fx_until }) }}
                        {%- elseif billing.cancelled and billing.periodEndsAt -%}
                            {{ 'billing.cancelled_until'|trans({ when: billing.periodEndsAt|fx_until }) }}
                        {%- elseif billing.periodEndsAt -%}
                            {{ 'billing.renews'|trans({ when: billing.periodEndsAt|fx_until }) }}
                        {%- else -%}
                            {{ 'billing.plan.free_help'|trans }}
                        {%- endif -%}
                    </span>
                </div>

                {% if billing.hasCustomerAccount and billing.paymentConfigured %}
                    <form method="post" action="{{ path('billing_portal') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('billing-portal') }}">
                        <button type="submit" class="fx-button fx-button--small">{{ 'billing.manage'|trans }}</button>
                    </form>
                {% endif %}
            </div>

            {# Où l'on en est des places, dès qu'on est plusieurs : seul, le
               décompte n'apprendrait rien. #}
            {% if billing.members > 1 %}
                <div class="fx-settings__row">
                    <div class="fx-settings__label">
                        <span class="fx-card__title">{{ 'billing.members_used'|trans({ used: billing.members, allowance: billing.memberAllowance }) }}</span>
                        <span class="fx-card__help">{{ 'billing.members_help'|trans }}</span>
                    </div>

                    <span class="fx-meter fx-billing__meter">
                        <span class="fx-meter__value" style="width: {{ min(100, (billing.members / billing.memberAllowance * 100)|round) }}%"></span>
                    </span>
                </div>
            {% endif %}

            {# Où l'on en est du plafond de notes. #}
            {% if billing.noteAllowance %}
                <div class="fx-settings__row">
                    <div class="fx-settings__label">
                        <span class="fx-card__title">{{ 'billing.notes_used'|trans({ used: billing.notes, allowance: billing.noteAllowance }) }}</span>
                        <span class="fx-card__help">{{ 'billing.notes_help'|trans }}</span>
                    </div>

                    <span class="fx-meter fx-billing__meter">
                        <span class="fx-meter__value" style="width: {{ min(100, (billing.notes / billing.noteAllowance * 100)|round) }}%"></span>
                    </span>
                </div>
            {% endif %}
        </section>

        {# ---------------------------------------------------------------- #}
        <section class="fx-settings__section">
            <p class="fx-eyebrow">{{ 'billing.plans'|trans }}</p>

            {% if not billing.paymentConfigured %}
                <p class="fx-card__help fx-billing__note">{{ 'billing.not_configured'|trans }}</p>
            {% endif %}

            {% for plan in plans %}
                <div class="fx-settings__row">
                    <div class="fx-settings__label">
                        <span class="fx-card__title">{{ ('billing.plan.' ~ plan.value)|trans }}</span>
                        <span class="fx-card__help">
                            {{ ('billing.plan.' ~ plan.value ~ '_help')|trans }}
                            {%- if plan.isBilledPerSeat %}
                                {{ 'billing.seats'|trans({ count: billing.members }) }}
                            {% endif -%}
                        </span>
                    </div>

                    {# « En cours » vaut pour un palier **payé**, pas pour celui
                       que l'essai prête : pendant l'essai on est sur le
                       personnel sans l'avoir payé, et désactiver son bouton
                       interdirait justement de convertir l'essai. #}
                    {% set isCurrent = not billing.trialing and billing.entitled == plan %}

                    {% if billing.paymentConfigured %}
                        <form method="post" action="{{ path('billing_checkout') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('billing-checkout') }}">
                            <input type="hidden" name="plan" value="{{ plan.value }}">
                            <button type="submit" class="fx-button fx-button--small {{ isCurrent ? '' : 'fx-button--primary' }}"
                                    {{ isCurrent ? 'disabled' : '' }}>
                                {{ (isCurrent ? 'billing.current_plan' : 'billing.choose')|trans }}
                            </button>
                        </form>
                    {% endif %}
                </div>
            {% endfor %}
        </section>
    </div>
{% endblock %}
