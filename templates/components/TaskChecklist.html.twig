{% set list = this.list %}

<div {{ attributes }} class="fx-checklist">
    {% if list is null %}
        <p class="fx-card__help">{{ 'task.list_gone'|trans }}</p>
    {% else %}
        <p class="fx-note__meta">
            <span>{{ 'task.open_count'|trans({ count: list.openItems|length }) }}</span>
            <span>·</span>
            <span>{{ list.progress }} %</span>
        </p>

        <div class="fx-meter fx-checklist__meter">
            <span class="fx-meter__value" style="width: {{ list.progress }}%"></span>
        </div>

        <ul class="fx-checklist__items">
            {% for item in list.openItems %}
                <li class="fx-task-line">
                    <button type="button" class="fx-check"
                            data-action="live#action" data-live-action-param="toggle"
                            data-live-task-id-param="{{ item.id }}"
                            aria-label="{{ 'task.check'|trans }}">
                        <span class="fx-check__tick">✓</span>
                    </button>
                    <span class="fx-task-line__text">{{ item.text }}</span>
                    <button type="button" class="fx-checklist__remove"
                            data-action="live#action" data-live-action-param="remove"
                            data-live-task-id-param="{{ item.id }}"
                            aria-label="{{ 'task.remove'|trans }}">×</button>
                </li>
            {% endfor %}
        </ul>

        <form data-action="live#action:prevent" data-live-action-param="add" class="fx-checklist__add">
            <input type="text"
                   class="fx-field__control fx-field__control--bare"
                   placeholder="{{ 'task.add_placeholder'|trans }}"
                   aria-label="{{ 'task.add_placeholder'|trans }}"
                   data-model="draft"
                   value="{{ draft }}">
        </form>

        {% if list.hasCompleted %}
            <p class="fx-eyebrow fx-checklist__done-title">{{ 'task.completed'|trans({ count: list.completedItems|length }) }}</p>
            <ul class="fx-checklist__items">
                {% for item in list.completedItems %}
                    <li class="fx-task-line">
                        <button type="button" class="fx-check fx-check--done"
                                data-action="live#action" data-live-action-param="toggle"
                                data-live-task-id-param="{{ item.id }}"
                                aria-label="{{ 'task.uncheck'|trans }}">
                            <span class="fx-check__tick">✓</span>
                        </button>
                        <span class="fx-task-line__text fx-task-line__text--done">{{ item.text }}</span>
                        <button type="button" class="fx-checklist__remove"
                                data-action="live#action" data-live-action-param="remove"
                                data-live-task-id-param="{{ item.id }}"
                                aria-label="{{ 'task.remove'|trans }}">×</button>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        {% if list.isEmpty %}
            <p class="fx-card__help fx-checklist__empty">{{ 'task.list_empty'|trans }}</p>
        {% endif %}
    {% endif %}
</div>
