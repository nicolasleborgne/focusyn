{# Le débounce est côté client : sans lui, chaque frappe déclencherait une
   requête, ce qui rendrait la frappe saccadée sur une connexion lente.

   Il n'y a pas de titre d'écran : dans la maquette, le champ *est* le titre. #}
<div {{ attributes }} class="fx-search">
    <input type="text"
           class="fx-search__input"
           placeholder="{{ 'notebook.search.placeholder'|trans }}"
           aria-label="{{ 'notebook.search.placeholder'|trans }}"
           autofocus
           data-model="debounce(300)|query"
           value="{{ query }}">

    {% set notes = this.results %}
    {% set tasks = this.taskResults %}

    {% if this.hasSearched %}
        <p class="fx-search__scope">
            <span>{{ 'notebook.search.results'|trans({ count: notes|length + tasks|length }) }}</span>
            <span>{{ 'notebook.search.scopes'|trans }}</span>
        </p>

        {% if tasks is not empty %}
            <p class="fx-search__band">
                <span class="fx-eyebrow">{{ 'shell.nav.tasks'|trans }}</span>
                <span class="fx-search__rule"></span>
                <span class="fx-search__tally">{{ 'task.count'|trans({ count: tasks|length }) }}</span>
            </p>

            {% for task in tasks %}
                <a class="fx-hit fx-hit--task" href="{{ path('task_list_show', { id: task.listId }) }}">
                    <span class="fx-check {{ task.done ? 'fx-check--done' }}" aria-hidden="true"><span class="fx-check__tick">✓</span></span>
                    <span class="fx-hit__text {{ task.done ? 'fx-hit__text--done' }}">{{ task.text }}</span>
                    <span class="fx-hit__when">{{ task.listName }}</span>
                </a>
            {% endfor %}
        {% endif %}

        {% if notes is not empty %}
            <p class="fx-search__band">
                <span class="fx-eyebrow">{{ 'notebook.notes'|trans }}</span>
                <span class="fx-search__rule"></span>
                <span class="fx-search__tally">{{ 'notebook.note_count'|trans({ count: notes|length }) }}</span>
            </p>

            {% for note in notes %}
                <a class="fx-hit" href="{{ path('note_show', { id: note.id }) }}">
                    <span class="fx-hit__head">
                        <span class="fx-hit__title">{{ note.title }}</span>
                        <span class="fx-hit__when">{{ note.updatedAt|fx_ago }}</span>
                    </span>
                    {% if note.excerpt is not empty %}
                        <span class="fx-hit__excerpt">{{ note.excerpt }}</span>
                    {% endif %}
                </a>
            {% endfor %}
        {% endif %}

        {% if notes is empty and tasks is empty %}
            <p class="fx-search__empty">{{ 'notebook.search.nothing'|trans }}</p>
        {% endif %}
    {% endif %}
</div>
