{% set url = this.url %}

<section class="fx-settings__section" {{ attributes }}>
    <p class="fx-eyebrow">{{ 'reminder.feed.heading'|trans }}</p>

    <div class="fx-settings__row">
        <div class="fx-settings__label">
            <span class="fx-card__title">{{ 'reminder.feed.label'|trans }}</span>
            <span class="fx-card__help">{{ (url ? 'reminder.feed.help' : 'reminder.feed.absent')|trans }}</span>
        </div>

        <form method="post" action="{{ path('calendar_feed_rotate') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('calendar-feed-rotate') }}">
            <button type="submit" class="fx-button fx-button--small">
                {{ (url ? 'reminder.feed.rotate' : 'reminder.feed.open')|trans }}
            </button>
        </form>
    </div>

    {% if url %}
        {# L'adresse est un secret : elle se recopie, elle ne se partage pas. #}
        <input class="fx-field__control fx-feed__url" type="text" readonly value="{{ url }}"
               aria-label="{{ 'reminder.feed.label'|trans }}" onfocus="this.select()">
        <p class="fx-card__help fx-feed__warning">{{ 'reminder.feed.secret'|trans }}</p>
    {% endif %}
</section>
