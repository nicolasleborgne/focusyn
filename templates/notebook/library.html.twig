{% extends 'shell.html.twig' %}

{% block title %}{{ 'shell.nav.library'|trans }} — Focusyn{% endblock %}
{% set crumb = 'shell.nav.library'|trans %}

{% block page %}
    {# Pas de titre d'écran : le champ de filtre ouvre la page, comme dans la
       maquette. Le fil d'Ariane dit déjà où l'on est. #}
    <div class="fx-app__content fx-app__content--library">
        {% for message in app.flashes('success') %}
            <p class="fx-settings__notice" role="status">{{ message|trans }}</p>
        {% endfor %}

        <twig:NoteLibrary :obsession="currentObsession" />
    </div>
{% endblock %}
