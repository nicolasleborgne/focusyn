<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr') }}"
      data-fx-accent="{{ fx_accent|default('ink') }}"
      data-fx-density="{{ fx_density|default('comfortable') }}"
      data-fx-prose="{{ fx_prose|default('serif') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>{% block title %}Focusyn{% endblock %}</title>
    <link rel="icon" href="{{ asset('icons/mark.svg') }}" type="image/svg+xml">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..600&family=Archivo:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap">

    {% block stylesheets %}{% endblock %}
    {% block javascripts %}
        {{ importmap('app') }}
    {% endblock %}
</head>
<body>
{% block body %}{% endblock %}
</body>
</html>
