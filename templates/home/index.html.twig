{% extends 'shell.html.twig' %}

{% set focusable = false %}

{% block title %}{{ 'shell.nav.home'|trans }} — Focusyn{% endblock %}
{% set crumb = 'home.crumb'|trans %}

{% block page %}
    <div class="fx-app__content fx-app__content--home">

        <p class="fx-eyebrow">{{ 'now'|format_datetime(pattern: 'EEEE d MMMM', locale: app.request.locale) }}</p>
        <h1 class="fx-heading fx-heading--hero fx-home__title">{{ 'home.title'|trans }}</h1>

        <section class="fx-home__stats" aria-label="{{ 'home.stats'|trans }}">
            {% set stats = [
                { value: shell().noteCount,        label: 'home.stat.notes' },
                { value: shell().obsessionCount,   label: 'home.stat.obsessions' },
                { value: home.monthlyWordCount|format_number(locale: app.request.locale), label: 'home.stat.words' },
                { value: shell().openTaskCount,    label: 'home.stat.open_tasks' },
            ] %}
            {% for stat in stats %}
                <div class="fx-stat">
                    <div class="fx-stat__value">{{ stat.value }}</div>
                    <div class="fx-stat__label">{{ stat.label|trans }}</div>
                </div>
            {% endfor %}
        </section>

        <section class="fx-home__section">
            <p class="fx-eyebrow fx-section-title">{{ 'home.resume'|trans }}</p>
            <div class="fx-home__notes">
                {% for note in home.recentNotes %}
                    <a class="fx-note-row fx-note-row--compact" href="{{ path('library') }}">
                        <span class="fx-note-row__main">
                            <span class="fx-note-row__title">{{ note.title }}</span>
                            <span class="fx-note-row__excerpt">{{ note.excerpt }}</span>
                            {% if note.obsessions is not empty %}
                                <span class="fx-note-row__tags">
                                    {% for obsession in note.obsessions %}
                                        <span class="fx-tag">{{ obsession }}</span>
                                    {% endfor %}
                                </span>
                            {% endif %}
                        </span>
                        <span class="fx-note-row__aside">
                            <span class="fx-note-row__meta">{{ note.updatedAt|format_date(pattern: 'd MMM', locale: app.request.locale) }}</span>
                            <span class="fx-note-row__meta">{{ 'home.words'|trans({ count: note.wordCount }) }}</span>
                        </span>
                    </a>
                {% endfor %}
            </div>
        </section>

        <section class="fx-home__section">
            <p class="fx-eyebrow fx-section-title">{{ 'home.next_tasks'|trans }}</p>
            {% if home.hasNothingPending %}
                <p class="fx-card__help">{{ 'home.all_clear'|trans }}</p>
            {% else %}
                <ul class="fx-home__tasks">
                    {% for task in home.nextTasks %}
                        <li class="fx-task-line">
                            <span class="fx-check" aria-hidden="true"><span class="fx-check__tick">✓</span></span>
                            <span class="fx-task-line__text">{{ task.text }}</span>
                            <a class="fx-task-line__list" href="{{ path('task_list_show', { id: task.listSlug }) }}">{{ task.listName }}</a>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>

        <section class="fx-home__section">
            <p class="fx-eyebrow fx-section-title">{{ 'shell.section.obsessions'|trans }}</p>
            {% set busiest = max(shell().obsessions|map(o => o.noteCount)|default([1])) %}
            <div class="fx-home__obsessions">
                {% for obsession in shell().obsessions %}
                    <a class="fx-obsession" href="{{ path('library', { obsession: obsession.slug }) }}">
                        <span class="fx-obsession__header">
                            <span class="fx-obsession__name">{{ obsession.name }}</span>
                            <span class="fx-obsession__count">{{ obsession.noteCount }}</span>
                        </span>
                        <span class="fx-obsession__bar">
                            <span class="fx-obsession__fill" style="width: {{ (obsession.noteCount / busiest * 100)|round }}%"></span>
                        </span>
                    </a>
                {% endfor %}
            </div>
        </section>

    </div>
{% endblock %}
