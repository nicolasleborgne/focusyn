{% extends 'shell.html.twig' %}

{% block title %}{{ 'shell.nav.tasks'|trans }} — Focusyn{% endblock %}
{% set crumb = 'shell.nav.tasks'|trans %}

{% block page %}
    <div class="fx-app__content fx-app__content--board">
        {# Titre, décompte en capitales, puis le bouton poussé à droite : la
           rangée d'en-tête de la maquette. #}
        <div class="fx-board__header">
            <h1 class="fx-heading">{{ 'shell.nav.tasks'|trans }}</h1>
            <span class="fx-eyebrow">{{ 'task.board_summary'|trans({ open: openCount, lists: lists|length }) }}</span>
            <span class="fx-board__spacer"></span>
            <form method="post" action="{{ path('task_list_open') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('task-list-open') }}">
                <button type="submit" class="fx-button fx-button--small">{{ 'task.new_list'|trans }}</button>
            </form>
        </div>

        {% for message in app.flashes('success') %}
            <p class="fx-settings__notice" role="status">{{ message|trans }}</p>
        {% endfor %}

        {% if lists is empty %}
            <div class="fx-library__empty">
                <p class="fx-card__help">{{ 'task.empty'|trans }}</p>
            </div>
        {% else %}
            <div class="fx-board">
                {% for list in lists %}
                    {# La carte montre le début de la liste, pas ce qu'il en
                       reste : une tâche cochée y garde sa place, barrée. #}
                    <a class="fx-board__card" href="{{ path('task_list_show', { id: list.id }) }}">
                        <span class="fx-board__head">
                            <span class="fx-board__mark" aria-hidden="true"></span>
                            <span class="fx-board__name">{{ list.name }}</span>
                            <span class="fx-board__ratio">{{ list.completedItems|length }}/{{ list.items|length }}</span>
                        </span>

                        <span class="fx-board__peek">
                            {% for item in list.peek %}
                                <span class="fx-board__peek-item {{ item.done ? 'fx-board__peek-item--done' }}">{{ item.text }}</span>
                            {% endfor %}
                        </span>

                        <span class="fx-meter fx-board__meter">
                            <span class="fx-meter__value" style="width: {{ list.progress }}%"></span>
                        </span>
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
