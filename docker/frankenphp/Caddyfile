{
	{$CADDY_GLOBAL_OPTIONS}

	# L'API d'administration de Caddy écoute sinon sur localhost:2019, et
	# permet de reconfigurer le serveur à chaud. Rien ici ne s'en sert, et
	# depuis que PHP ne tourne plus sous root elle serait le chemin le plus
	# court entre une exécution de code et la maîtrise du serveur.
	admin off

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	log {
		format filter {
			request>uri query {
				replace authorization REDACTED
			}
		}
	}

	root {$SERVER_ROOT:public/}
	encode zstd br gzip

	# Le service worker doit pouvoir contrôler toute l'origine et ne jamais
	# être servi depuis le cache HTTP : sans cela, une mise à jour de la PWA
	# peut rester invisible pendant des heures.
	@service_worker path /sw.js
	header @service_worker {
		Cache-Control "no-cache"
		Service-Worker-Allowed "/"
	}

	# Les fichiers versionnés par AssetMapper portent un condensat dans leur
	# nom : ils sont immuables et peuvent être mis en cache un an.
	@immutable path_regexp ^/assets/.+-[A-Za-z0-9_-]{7,}\.(css|js|svg|png|woff2?)$
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Ces en-têtes valent surtout pour ce que PHP ne voit jamais : les actifs,
	# le service worker, le manifeste, les icônes. L'application les pose
	# elle-même par NelmioSecurityBundle, avec les mêmes valeurs — Caddy les
	# remplace alors par les siennes, ce qui ne change rien tant que les deux
	# fichiers sont d'accord. Les garder ici est ce qui protège les fichiers
	# statiques ; les garder là-bas est ce qui protège un déploiement qui
	# n'aurait pas ce Caddyfile.
	#
	# Rien sur HSTS ni sur le CSP : le premier ne doit partir que sur une
	# requête déjà chiffrée, le second a besoin d'un nonce par requête. Les
	# deux appartiennent donc à l'application.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
	}

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	php_server {
		#worker /app/public/index.php
	}
}

# ---------------------------------------------------------------------------
# Point d'écoute de la sonde de disponibilité
# ---------------------------------------------------------------------------
# Le site public ne répond qu'à son propre nom d'hôte : en production,
# `SERVER_NAME` vaut `focusyn.fr`, et la sonde de Docker — qui interroge
# forcément « localhost » depuis l'intérieur du conteneur — ne trouvait aucun
# site correspondant. Le conteneur était donc déclaré mort en permanence, sans
# que rien ne le signale : la CI ne lance pas la sonde.
#
# D'où ce second point d'écoute, **sur la boucle locale seulement** : aucun
# autre conteneur du réseau ne l'atteint, et il ne sert qu'un seul chemin.
# `http://` explicite pour que Caddy n'essaie pas d'y poser un certificat.
http://127.0.0.1:2020 {
	root {$SERVER_ROOT:public/}

	route /healthz {
		php_server
	}

	respond 404
}

import Caddyfile.d/*.caddyfile
